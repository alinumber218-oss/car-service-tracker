# Routes npm installs for the mobile app through Nexus instead of the
# public npm registry. Point this at a Nexus "npm group" repository that aggregates:
#   - an "npm (proxy)" repository proxying https://registry.npmjs.org
#   - optionally, an "npm (hosted)" repository for any private/internal packages
#
# Replace the hostname below with your real Nexus instance.
# See docs/NEXUS.md for how to create these repositories in Nexus.
registry=https://nexus.yourcompany.example.com/repository/npm-group/

# Auth token for the Nexus npm repository, read from the environment at
# install time - never commit a real token here. Generate one via Nexus:
# your user icon -> "NPM Realm Token", or a Nexus service account token.
# npm only supports plain ${VAR} substitution in .npmrc (no bash-style
# ${VAR:-default} fallbacks), so NEXUS_NPM_TOKEN must be set in the shell
# or CI environment before running npm install.
localhost:8081/repository/npm-group/:_authToken=${NEXUS_NPM_TOKEN}

# Fail fast instead of silently falling back to the public registry if
# Nexus is unreachable or misconfigured.
strict-ssl=true
always-auth=true
