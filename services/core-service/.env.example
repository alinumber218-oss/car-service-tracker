# Server
PORT=4002
NODE_ENV=development

# Databases (separate DBs per the microservices data-ownership model)
VEHICLE_DATABASE_URL=postgresql://app_user:app_password@localhost:5432/vehicle
SERVICELOG_DATABASE_URL=postgresql://app_user:app_password@localhost:5432/servicelog

# Auth - must match auth-service's access secret to verify incoming JWTs
JWT_ACCESS_SECRET=change-me-access-secret

# Message bus
RABBITMQ_URL=amqp://guest:guest@localhost:5672
SERVICE_LOG_EVENTS_EXCHANGE=service-log-events

# CORS
CORS_ORIGIN=*
